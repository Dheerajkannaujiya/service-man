# ==============================================================================
# ServiceMan Master .gitignore
# Prevents sensitive secrets, heavy dependencies, build artifacts, and
# unnecessary system/editor files from being uploaded to GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENVIRONMENT & SECRETS (STRICTLY FORBIDDEN FROM GITHUB)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# ------------------------------------------------------------------------------
# 2. DEPENDENCIES & PACKAGE CACHES
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
client/node_modules/
server/node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# ------------------------------------------------------------------------------
# 3. BUILD ARTIFACTS & COMPILED OUTPUTS
# ------------------------------------------------------------------------------
dist/
dist-ssr/
client/dist/
build/
client/build/
out/
.next/
*.tsbuildinfo

# ------------------------------------------------------------------------------
# 4. USER UPLOADS & MEDIA (Only preserve directory structure via .gitkeep)
# ------------------------------------------------------------------------------
server/uploads/*
!server/uploads/**/.gitkeep
uploads/*
!uploads/**/.gitkeep

# ------------------------------------------------------------------------------
# 5. LOGS, DEBUGGERS & DIAGNOSTICS
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
core
core.*

# ------------------------------------------------------------------------------
# 6. TESTING & COVERAGE REPORTS
# ------------------------------------------------------------------------------
coverage/
.nyc_output/
*.lcov

# ------------------------------------------------------------------------------
# 7. CACHES & TEMPORARY FILES
# ------------------------------------------------------------------------------
.cache/
**/.cache/
.eslintcache
.stylelintcache
.parcel-cache
.turbo/
tmp/
temp/
*.tmp
*.temp
*.bak
*~

# ------------------------------------------------------------------------------
# 8. IDE, EDITORS & WORKSPACE SETTINGS
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ------------------------------------------------------------------------------
# 9. OPERATING SYSTEM ARTIFACTS
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Linux
*~
.directory
