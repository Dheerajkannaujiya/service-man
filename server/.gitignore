# ==========================================
# ServiceMan Server .gitignore
# ==========================================

# 1. Environment Secrets
.env
.env.*
*.env
*.env.local

# 2. Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 3. Dynamic Uploads
uploads/*
!uploads/**/.gitkeep

# 4. Logs, Dumps & Caches
logs/
*.log
.cache/
coverage/
*.tmp
*.temp
*.bak

# 5. OS & IDE
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
