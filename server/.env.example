# ==============================================================================
# ServiceMan Backend Environment Template (.env.example)
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (Leave as is for automatic in-memory DB or insert free MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/serviceman
REDIS_URL=redis://127.0.0.1:6379

# JWT Secrets
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_key_minimum_32_characters
JWT_REFRESH_EXPIRES_IN=30d

# Razorpay Payment Gateway (Free Test Mode from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Google Maps API (Free $200 monthly credit from https://console.cloud.google.com)
GOOGLE_MAPS_API_KEY=

# Optional S3 Storage & AI API (built-in fallbacks used if blank)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=serviceman-kyc-vault
AI_API_KEY=
